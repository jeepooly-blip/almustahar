# ===================================================
# Legal Navigator Pro — Environment variables
# Copy to .env.local for development, .env.production for Vercel
# ===================================================

# ----- Database (Supabase Postgres) -----
# Get from Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# For migrations (use direct connection, port 5432)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ----- Supabase -----
# Get from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."  # server-side only, never expose

# ----- AI / LLM (PRD § 8.1) -----
# Google Gemini (recommended, free tier: 15 RPM, 1500 RPD) — https://aistudio.google.com/apikey
# Handles BOTH text analysis and 768-dim embeddings in one key.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.0-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# Optional paid fallbacks
GROQ_API_KEY="gsk_..."            # Groq Llama 3.1 70B (fallback)
OPENAI_API_KEY="sk-..."           # OpenAI GPT-4o-mini (fallback)
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# ----- Auth (PRD § 8.1) -----
# JWT secret for session cookies — generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-production-use-a-random-48-char-string"
NEXTAUTH_URL="http://localhost:3000"   # Update to https://your-domain.vercel.app in prod

# Phone OTP provider (Twilio or Vonage)
TWILIO_ACCOUNT_SID="ACxxxxx"
TWILIO_AUTH_TOKEN="xxxxx"
TWILIO_PHONE_NUMBER="+1234567890"
# OR
VONAGE_API_KEY="xxxxx"
VONAGE_API_SECRET="xxxxx"

# ----- Payments (PRD § 8.1) -----
HYPERPAY_BASE_URL="https://test.oppwa.com"  # Use https://oppwa.com for production
HYPERPAY_ENTITY_ID="xxxxx"
HYPERPAY_ACCESS_TOKEN="xxxxx"

# ----- Storage / CDN -----
SUPABASE_STORAGE_BUCKET="documents"

# ----- Rate Limiting (PRD § 11.3) -----
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# ----- Analytics (PRD § 8.1) -----
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID="G-XXXXX"

# ----- App config -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
